{
  "functions": {
    "api/backend.js": {
      "maxDuration": 60
    },
    "api/backend/[...path].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/backend/:path*",
      "destination": "/api/backend?path=:path*"
    },
    {
      "source": "/((?!api/backend).*)",
      "destination": "/index.html"
    }
  ]
}
