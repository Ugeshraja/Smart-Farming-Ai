# Ignore environment secrets and private credentials
.env
.env.*
*.env
serviceAccountKey.json

# Ignore Python runtime caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/

# Ignore runtime media uploads and audio caches (created dynamically at runtime)
static/predictions/*
!static/predictions/.gitkeep
static/tts/*
!static/tts/.gitkeep
cache/*
!cache/.gitkeep
cache/tts/*
!cache/tts/.gitkeep
*.mp3
*.wav

# Ignore Git, IDE, and temporary files
.git/
.gitignore
.dockerignore
.vscode/
.idea/
*.swp
*~
.DS_Store

# Ignore test files and scratch scripts
tests/
scratch/
docs/

# Exclude model weights from Docker build context (provisioned via model_bootstrap from Hugging Face Hub)
models/*.pt
models/*.pth
models/brinjal/*.pth

# Explicitly ensure RAG knowledge base is included
!rag/
!rag/knowledge_base/
!rag/knowledge_base/*.txt
