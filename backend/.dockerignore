# Ignore environment secrets and private credentials
.env
.env.*
*.env
serviceAccountKey.json

# Ignore Python runtime caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/

# Ignore runtime media uploads and audio caches (created dynamically at runtime)
static/predictions/*
!static/predictions/.gitkeep
static/tts/*
!static/tts/.gitkeep
cache/*
!cache/.gitkeep
cache/tts/*
!cache/tts/.gitkeep
*.mp3
*.wav

# Ignore Git, IDE, and temporary files
.git/
.gitignore
.dockerignore
.vscode/
.idea/
*.swp
*~
.DS_Store

# Ignore test files and scratch scripts
tests/
scratch/
docs/

# Explicitly ensure models and RAG knowledge base are NOT ignored
!models/
!models/yolo11_best.pt
!models/resnet50_best_model.pth
!models/sam_vit_b_01ec64.pth
!models/brinjal/best_model.pth
!rag/
!rag/knowledge_base/
!rag/knowledge_base/*.txt
