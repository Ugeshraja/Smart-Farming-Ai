# Ignore environment secrets and private credentials
.env
.env.*
*.env
serviceAccountKey.json
backend/serviceAccountKey.json
backend/.env
backend/.env.*

# Ignore frontend build and dependencies
node_modules/
dist/
farmer-portal/

# Ignore Python runtime caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/

# Ignore runtime media uploads and audio caches
backend/static/predictions/*
!backend/static/predictions/.gitkeep
backend/static/tts/*
!backend/static/tts/.gitkeep
backend/cache/*
!backend/cache/.gitkeep
backend/cache/tts/*
!backend/cache/tts/.gitkeep
*.mp3
*.wav

# Ignore Git, IDE, and temporary files
.git/
.gitignore
.dockerignore
.vscode/
.idea/
*.swp
*~
.DS_Store

# Ignore test files and scratch scripts
backend/tests/
backend/docs/
tests/
scratch/

# Exclude model weights from Docker build context (provisioned via model_bootstrap from Hugging Face Hub)
backend/models/*.pt
backend/models/*.pth
backend/models/brinjal/*.pth

# Explicitly ensure RAG knowledge base is included
!backend/rag/
!backend/rag/knowledge_base/
!backend/rag/knowledge_base/*.txt
