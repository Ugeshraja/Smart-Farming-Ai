# ==============================================================================
# SmartFarm AI Backend - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' inside the backend/ folder:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
#
# FOR LOCAL DEVELOPMENT:
#   Default values will work out of the box with development mock services.
#
# FOR PRODUCTION DEPLOYMENT (e.g. Cloud VM, Docker, Render, AWS, GCP):
#   1. Set ENVIRONMENT="production"
#   2. Change SECRET_KEY to a secure 64-character random string (e.g. openssl rand -hex 32)
#   3. Configure CORS_ORIGINS with your deployed frontend domain(s) (no wildcards)
#   4. Configure DATABASE_URL with your production PostgreSQL connection string
#   5. Supply your production GEMINI_API_KEY
# ==============================================================================

# Environment Setting: "development" or "production"
ENVIRONMENT="development"

# Server Configuration
PROJECT_NAME="SmartFarm AI Backend API"
API_V1_PREFIX="/api"
PORT=8000
DEBUG=True

# Security / Session settings (MUST CHANGE IN PRODUCTION)
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated domains)
# In development: allows localhost Vite/React ports
# In production: replace with exact production frontend URL(s), e.g. "https://smartfarm.example.com"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Database Configuration (PostgreSQL connection string)
# Example: DATABASE_URL="postgresql+psycopg://username:password@localhost:5432/smartfarm_ai"
DATABASE_URL=""

# Google Gemini LLM API Configuration
# Supply your Google Gemini API key to enable AI agricultural advisory
GEMINI_API_KEY=""
LLM_API_KEY=""
LLM_MODEL="gemini-3.5-flash-lite"

# Firebase Service Account Credentials (Optional)
# Option A: Path to serviceAccountKey.json file (relative to backend/ or absolute)
FIREBASE_CREDENTIALS_PATH=""
# Option B: Individual Firebase service account environment variables
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# OpenWeather API Configuration (Optional server-side key for live weather)
OPENWEATHER_API_KEY=""
WEATHER_API_KEY=""

# Voice API Configuration (Optional Sarvam AI key for voice STT)
VOICE_API_KEY=""

# Trained AI Models Configuration (Deployment-Ready Relative Paths)
MODEL_DIR="models"
YOLO_MODEL_PATH="models/yolo11_best.pt"
RESNET_MODEL_PATH="models/resnet50_best_model.pth"
SAM_MODEL_PATH="models/sam_vit_b_01ec64.pth"
BRINJAL_RESNET_MODEL_PATH="models/brinjal/best_model.pth"
RAG_KNOWLEDGE_PATH="rag/knowledge_base"

# Hugging Face Model Repository Configuration (Private Model Hosting on GPU)
HF_MODEL_REPO_ID="ugeshraja007/smartfarm-ai-models"
HF_TOKEN=""
HF_MODEL_REVISION="main"
