{
  "functions": {
    "api/backend.js": {
      "maxDuration": 60
    },
    "api/backend/[...path].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/backend?path=api/chat"
    },
    {
      "source": "/api/chat/:path*",
      "destination": "/api/backend?path=api/chat/:path*"
    },
    {
      "source": "/api/predict",
      "destination": "/api/backend?path=api/predict"
    },
    {
      "source": "/api/predict/:path*",
      "destination": "/api/backend?path=api/predict/:path*"
    },
    {
      "source": "/predict",
      "destination": "/api/backend?path=api/predict"
    },
    {
      "source": "/predict/:path*",
      "destination": "/api/backend?path=api/predict/:path*"
    },
    {
      "source": "/api/backend/:path*",
      "destination": "/api/backend?path=:path*"
    },
    {
      "source": "/api/voice/:path*",
      "destination": "/api/backend?path=api/voice/:path*"
    },
    {
      "source": "/api/voice",
      "destination": "/api/backend?path=api/voice"
    },
    {
      "source": "/voice/:path*",
      "destination": "/api/backend?path=voice/:path*"
    },
    {
      "source": "/voice",
      "destination": "/api/backend?path=voice"
    },
    {
      "source": "/api/tts/:path*",
      "destination": "/api/backend?path=api/tts/:path*"
    },
    {
      "source": "/api/tts",
      "destination": "/api/backend?path=api/tts"
    },
    {
      "source": "/tts/:path*",
      "destination": "/api/backend?path=tts/:path*"
    },
    {
      "source": "/tts",
      "destination": "/api/backend?path=tts"
    },
    {
      "source": "/((?!api/backend|api/predict|predict|api/voice|voice|api/chat|api/tts|tts).*)",
      "destination": "/index.html"
    }
  ]
}
